# Production deployment template.
# Copy values into Render/Vercel dashboards. Do not put real secrets in git.

# Render API service
NODE_ENV=production
# Render normally injects PORT. Leave unset unless your host requires it.
# PORT=10000
WEB_ORIGIN=https://YOUR_VERCEL_FRONTEND_DOMAIN
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/sk-quiz-coach?retryWrites=true&w=majority
REDIS_URL=rediss://USER:PASSWORD@HOST:PORT
JWT_ACCESS_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SK_CENTRAL_SERVICE_TOKEN=REPLACE_WITH_SHARED_SERVICE_TOKEN
SK_CENTRAL_AUTH_URL=https://YOUR_SK_CENTRAL_API_DOMAIN/api
SK_CENTRAL_LOGIN_URL=https://YOUR_SK_CENTRAL_FRONTEND_DOMAIN/login
SK_CENTRAL_SSO_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS_MATCHING_SK_CENTRAL
GEMINI_API_KEY=REPLACE_WITH_PRODUCTION_GEMINI_KEY
GEMINI_MODEL=gemini-2.0-flash
PASSWORD_RESET_URL=https://YOUR_VERCEL_FRONTEND_DOMAIN/reset-password
VERIFY_EMAIL_URL=https://YOUR_VERCEL_FRONTEND_DOMAIN/verify-email
MAIL_FROM=SK Quiz Coach <hello@your-domain.com>
RESEND_API_KEY=REPLACE_IF_USING_RESEND
SMTP_HOST=REPLACE_IF_USING_SMTP
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_IF_USING_SMTP
SMTP_PASS=REPLACE_IF_USING_SMTP

# Vercel frontend project
VITE_API_URL=https://YOUR_RENDER_API_DOMAIN/api
VITE_SK_CENTRAL_AUTH_URL=https://YOUR_SK_CENTRAL_API_DOMAIN/api
VITE_SK_CENTRAL_LOGIN_URL=https://YOUR_SK_CENTRAL_FRONTEND_DOMAIN/login
