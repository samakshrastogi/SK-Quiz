NODE_ENV=production
PORT=8080
WEB_ORIGIN=https://YOUR_FRONTEND_DOMAIN
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/quiz
MONGODB_DB_NAME=quiz
REDIS_URL=redis://USER:PASSWORD@HOST:PORT
JWT_ACCESS_SECRET=GENERATE_64_BYTE_SECRET
JWT_REFRESH_SECRET=GENERATE_ANOTHER_64_BYTE_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
RESEND_API_KEY=YOUR_RESEND_API_KEY
MAIL_FROM=SK Quiz Coach <otp@yourdomain.com>
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash
