# Backend example env. Copy to apps/api/.env.local for local development.

NODE_ENV=development
PORT=4001
WEB_ORIGIN=http://localhost:5474
MONGODB_URI=mongodb://127.0.0.1:27018/sk-quiz-coach
REDIS_URL=redis://127.0.0.1:6380

JWT_ACCESS_SECRET=replace-with-64-plus-random-chars
JWT_REFRESH_SECRET=replace-with-64-plus-random-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

SK_CENTRAL_SERVICE_TOKEN=replace-with-shared-service-token
SK_CENTRAL_AUTH_URL=http://localhost:4002/api
SK_CENTRAL_LOGIN_URL=http://localhost:5475/login
SK_CENTRAL_SSO_SECRET=replace-with-32-plus-random-chars-matching-sk-central

GEMINI_API_KEY=replace-with-dev-gemini-key
GEMINI_MODEL=gemini-2.0-flash

PASSWORD_RESET_URL=http://localhost:5474/reset-password
VERIFY_EMAIL_URL=http://localhost:5474/verify-email

MAIL_FROM=SK Quiz Coach <hello@localhost>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
